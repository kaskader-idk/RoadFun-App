# Set YOUR OWN unique secrets before starting. Never commit .env.
ROADFUN_ADMIN_PASSWORD=REPLACE-WITH-A-STRONG-UNIQUE-PASSWORD
ROADFUN_INVITE_CODE=REPLACE-WITH-A-PRIVATE-INVITATION-CODE
# Address search and elevation still use separate services. Routing uses only the browser-local graph.
# Optional Valhalla fallback (set to disabled to turn it off)
ROADFUN_ELEVATION_URL=https://api.opentopodata.org/v1/srtm90m

ROADFUN_GEOCODER_URL=https://photon.komoot.io
