# Set YOUR OWN unique secrets before starting. Never commit .env.
ROADFUN_ADMIN_PASSWORD=REPLACE-WITH-A-STRONG-UNIQUE-PASSWORD
ROADFUN_INVITE_CODE=REPLACE-WITH-A-PRIVATE-INVITATION-CODE
# DEMO: third-party services. For reliable production use your own routing/elevation servers.
ROADFUN_ROUTING_URL=https://router.project-osrm.org
# Optional Valhalla fallback (set to disabled to turn it off)
ROADFUN_ROUTING_FALLBACK_URL=https://valhalla1.openstreetmap.de
ROADFUN_ELEVATION_URL=https://api.opentopodata.org/v1/srtm90m

# Optional offline OSRM (after scripts/setup-local-routing.sh):
# ROADFUN_ROUTING_URL=http://osrm:5000
# Optional private Photon geocoder; public default has strict fair-use limits:
ROADFUN_GEOCODER_URL=https://photon.komoot.io
